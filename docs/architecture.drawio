        </mxCell>
        
        <mxCell id="sub_docker" value="Docker Development Environment&#xa;• Python 3.11 + OpenJDK 11&#xa;• PySpark 3.5.0 + Delta-Spark 3.0.0&#xa;• Volume: local_data_lake (/data_lake)&#xa;• Zero Cloud Cost Testing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#F59E0B;align=left;spacingLeft=15;fontSize=11;" vertex="1" parent="zone_local">
          <mxGeometry x="40" y="460" width="400" height="95" as="geometry" />
