        <!-- CONNECTING ARROWS IN TECH DIAGRAM -->
        <mxCell id="t_edge1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#3B82F6;" edge="1" parent="1" source="t_cli" target="t_ci_pipeline">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="t_edge2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#10B981;" edge="1" parent="1" source="t_ci_pipeline" target="t_cd_pipeline">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="t_edge3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#FF3621;" edge="1" parent="1" source="t_cd_pipeline" target="t_control_plane">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
