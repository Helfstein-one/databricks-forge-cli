<mxfile host="Electron" modified="2026-09-07T23:59:00.000Z" agent="5.0" version="21.6.8" type="device">
  
  <!-- ========================================================================================== -->
  <!-- ABA 1: EXPERIÊNCIA DO USUÁRIO (FUNCIONAL)                                                 -->
  <!-- ========================================================================================== -->
  <diagram id="tab-functional" name="1. Experiência do Usuário (Funcional)">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <!-- HEADER -->
        <mxCell id="f_header" value="Jornada do Engenheiro de Dados — Experiência do Usuário no Databricks Forge" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=24;fontStyle=1;fontColor=#FF3621;" vertex="1" parent="1">
          <mxGeometry x="350" y="30" width="1100" height="40" as="geometry" />
        </mxCell>
        <mxCell id="f_sub" value="Fluxo passo a passo: Scaffolding interativo ➔ Desenvolvimento Docker ➔ Gestão de Secrets ➔ Orquestração de DAG ➔ Deploy no Databricks CE" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=13;fontColor=#64748B;" vertex="1" parent="1">
          <mxGeometry x="350" y="70" width="1100" height="25" as="geometry" />
        </mxCell>

        <!-- STEP 1: INITIALIZATION -->
        <mxCell id="step1" value="Etapa 1: Scaffolding do Projeto&#xa;&#xa;Comando:&#xa;forge init customer-lakehouse&#xa;--cloud aws --node-type i3.xlarge --workers 2&#xa;&#xa;Resultado:&#xa;• Banner 3D estilizado no terminal&#xa;• Estrutura completa renderizada&#xa;• Docker, Chispa, DAG e Secrets pré-configurados" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;align=left;spacingLeft=15;fontSize=12;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="80" y="130" width="340" height="170" as="geometry" />
        </mxCell>

        <!-- STEP 2: LOCAL DEV -->
        <mxCell id="step2" value="Etapa 2: Dev Local sem Custo de Nuvem&#xa;&#xa;Comando:&#xa;make docker-test (ou make unit-test)&#xa;&#xa;Funcionalidades:&#xa;• Container com OpenJDK 11 e PySpark 3.5&#xa;• Testes unitários Chispa (assert_df_equality)&#xa;• Gravação ACID em volume local (Delta Lake)&#xa;• Sem consumo de DBU ou custo de nuvem" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#F59E0B;align=left;spacingLeft=15;fontSize=12;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="480" y="130" width="360" height="170" as="geometry" />
        </mxCell>

        <!-- STEP 3: SECRETS SYNC -->
        <mxCell id="step3" value="Etapa 3: Gestão Segura de Secrets&#xa;&#xa;Comando:&#xa;forge secret sync-env --scope-name &quot;retail_scope&quot;&#xa;&#xa;Benefícios:&#xa;• Migra .env local para Databricks Secret Scope&#xa;• Código unificado com get_secret(scope, key)&#xa;• Zero senhas ou chaves expostas no Git" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;align=left;spacingLeft=15;fontSize=12;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="900" y="130" width="360" height="170" as="geometry" />
        </mxCell>

        <!-- STEP 4: DAG ORCHESTRATION -->
        <mxCell id="step4" value="Etapa 4: Orquestração de DAG Multi-Job&#xa;&#xa;Comandos:&#xa;forge dag validate (Kahn's Topological Sort)&#xa;forge dag run --mode local&#xa;forge sql run sql/01_clean_transactions.sql&#xa;&#xa;Tarefas Encadeadas:&#xa;1. Ingestão Bronze (Python Wheel)&#xa;2. Limpeza Silver (SQL Job)&#xa;3. Agregação Gold (SQL KPIs)&#xa;4. Relatório Analítico (Notebook)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAF5FF;strokeColor=#A855F7;align=left;spacingLeft=15;fontSize=12;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="1320" y="130" width="360" height="190" as="geometry" />
        </mxCell>

        <!-- STEP 5: CI/CD & BUILD -->
        <mxCell id="step5" value="Etapa 5: Build &amp; Esteira de CI/CD&#xa;&#xa;Comandos:&#xa;forge build (Compila dist/*.whl)&#xa;git push origin main&#xa;&#xa;Automação GitHub Actions:&#xa;• Linting estrito com Ruff&#xa;• Matriz de testes Python (3.10, 3.11, 3.12)&#xa;• Benchmarks de performance de dados&#xa;• Build e empacotamento do binário" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;align=left;spacingLeft=15;fontSize=12;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="480" y="380" width="360" height="180" as="geometry" />
        </mxCell>

        <!-- STEP 6: DEPLOY TO DATABRICKS CE -->
        <mxCell id="step6" value="Etapa 6: Deploy &amp; Execução no Databricks CE&#xa;&#xa;Comando:&#xa;forge deploy --target-path &quot;/Shared/lakehouse&quot;&#xa;forge run-notebook --target-path &quot;/Shared/lakehouse&quot;&#xa;&#xa;Ambiente Databricks:&#xa;• Publicação de Wheel e scripts SQL via Workspace API&#xa;• Master DAG Runner executando o grafo completo&#xa;• Widgets interativos (row_count, log_level)&#xa;• Visualização nativa com display() e assertions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF1F2;strokeColor=#E11D48;align=left;spacingLeft=15;fontSize=12;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="900" y="380" width="380" height="180" as="geometry" />
        </mxCell>

        <!-- ARROWS -->
        <mxCell id="fa1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=3;strokeColor=#3B82F6;" edge="1" parent="1" source="step1" target="step2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="fa2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=3;strokeColor=#F59E0B;" edge="1" parent="1" source="step2" target="step3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="fa3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=3;strokeColor=#10B981;" edge="1" parent="1" source="step3" target="step4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="fa4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=3;strokeColor=#A855F7;" edge="1" parent="1" source="step4" target="step5">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1500" y="350" />
              <mxPoint x="660" y="350" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="fa5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=3;strokeColor=#64748B;" edge="1" parent="1" source="step5" target="step6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>

  <!-- ========================================================================================== -->
  <!-- ABA 2: VISÃO DE NEGÓCIO (BUSINESS & ROI)                                                  -->
  <!-- ========================================================================================== -->
  <diagram id="tab-business" name="2. Visão de Negócio (Business &amp; ROI)">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <!-- HEADER -->
        <mxCell id="b_header" value="Arquitetura de Negócio — Proposta de Valor, ROI &amp; Governança" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=24;fontStyle=1;fontColor=#059669;" vertex="1" parent="1">
          <mxGeometry x="350" y="30" width="1100" height="40" as="geometry" />
        </mxCell>
        <mxCell id="b_sub" value="Como o Databricks Forge CLI reduz custos, mitiga riscos, acelera entregas e democratiza o Lakehouse" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=13;fontColor=#64748B;" vertex="1" parent="1">
          <mxGeometry x="350" y="70" width="1100" height="25" as="geometry" />
        </mxCell>

        <!-- VALUE PILLAR 1: COST OPTIMIZATION -->
        <mxCell id="b_pillar1" value="Redução Drástica de Custos (FinOps)&#xa;&#xa;• Custo Zero de DBU em Desenvolvimento:&#xa;  Testes unitários e iterações de código rodam&#xa;  100% em Docker local ou Databricks CE.&#xa;• Economia Estimada: 80% a 90% do compute bill&#xa;  de ambientes de desenvolvimento em nuvem.&#xa;• Seleção Precisa de Instâncias:&#xa;  Suporte a Single-Node para tarefas leves e&#xa;  instâncias otimizadas (i3.xlarge) na produção." style="swimlane;whiteSpace=wrap;html=1;fontSize=13;fontStyle=1;fillColor=#ECFDF5;strokeColor=#10B981;startSize=30;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="130" width="370" height="260" as="geometry" />
        </mxCell>

        <!-- VALUE PILLAR 2: TIME TO MARKET -->
        <mxCell id="b_pillar2" value="Aceleração de Time-to-Market&#xa;&#xa;• Scaffolding Padronizado Instantâneo:&#xa;  Novos pipelines são iniciados em minutos,&#xa;  eliminando semanas de setup repetitivo.&#xa;• Arquitetura Medallion Pronta:&#xa;  Templates homologados de Bronze, Silver e Gold&#xa;  com contratos de schema e regras de auditoria.&#xa;• Esteira CI/CD Automatizada:&#xa;  Build de Wheel e deploy no Databricks em&#xa;  cada merge aprovado." style="swimlane;whiteSpace=wrap;html=1;fontSize=13;fontStyle=1;fillColor=#EFF6FF;strokeColor=#3B82F6;startSize=30;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="490" y="130" width="370" height="260" as="geometry" />
        </mxCell>

        <!-- VALUE PILLAR 3: DEMOCRATIZATION -->
        <mxCell id="b_pillar3" value="Democratização do Databricks CE&#xa;&#xa;• Sem Barreira de Licenciamento:&#xa;  Engenheiros podem aprender, prototipar e validar&#xa;  soluções inteiras no Community Edition gratuito.&#xa;• Superação da Limitação da Jobs API:&#xa;  O Master DAG Runner executa fluxos complexos&#xa;  com múltiplos jobs sem precisar de licença paga.&#xa;• Testes com Databricks Connect v2:&#xa;  Experiência de computação em nuvem real." style="swimlane;whiteSpace=wrap;html=1;fontSize=13;fontStyle=1;fillColor=#FAF5FF;strokeColor=#8B5CF6;startSize=30;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="900" y="130" width="370" height="260" as="geometry" />
        </mxCell>

        <!-- VALUE PILLAR 4: SECURITY & COMPLIANCE -->
        <mxCell id="b_pillar4" value="Segurança, Compliance &amp; Qualidade&#xa;&#xa;• Gestão Centralizada de Secrets:&#xa;  Zero senhas ou tokens gravados em notebooks;&#xa;  sincronização com Secret Scopes encriptados.&#xa;• Qualidade Assegurada com Chispa:&#xa;  Validação estrita de dados e esquemas antes&#xa;  de qualquer deploy em produção.&#xa;• Rastreabilidade &amp; Versionamento:&#xa;  Controle de versão total com Git e Wheels." style="swimlane;whiteSpace=wrap;html=1;fontSize=13;fontStyle=1;fillColor=#FFF1F2;strokeColor=#E11D48;startSize=30;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="1310" y="130" width="370" height="260" as="geometry" />
        </mxCell>

        <!-- MEDALLION VALUE CHAIN -->
        <mxCell id="b_chain" value="Cadeia de Valor dos Dados (Medallion Value Chain)&#xa;&#xa;[Bronze: Ingestão Bruta] ➔ [Silver: Higienização &amp; Deduplicação] ➔ [Gold: Agregações &amp; KPIs Analíticos]&#xa;• Preservação de auditoria técnica (_ingested_at, _computed_at)&#xa;• Tabelas Delta Lake com garantias ACID e Time-Travel&#xa;• Prontidão analítica para BI, Dashboards e Modelos de Machine Learning" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#475569;align=center;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="440" width="1600" height="120" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>

