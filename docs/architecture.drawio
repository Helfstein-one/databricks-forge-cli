        <mxCell id="t_cli" value="databricks-forge-cli (Typer / Rich)&#xa;• forge init / build / deploy / dag / sql / secret" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E40AF;fontColor=#FFFFFF;fontStyle=1;fontSize=12;" vertex="1" parent="t_local">
          <mxGeometry x="30" y="50" width="400" height="50" as="geometry" />
        </mxCell>

        <mxCell id="t_secrets_mod" value="Módulo de Secrets (core/secrets.py)&#xa;• Parser de .env local&#xa;• Sincronizador Databricks Secrets API (/api/2.0/secrets/*)&#xa;• get_secret() com resolução híbrida" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;align=left;spacingLeft=15;fontSize=11;" vertex="1" parent="t_local">
          <mxGeometry x="30" y="120" width="400" height="75" as="geometry" />
        </mxCell>

        <mxCell id="t_dag_mod" value="Orquestrador DAG (core/workflow.py)&#xa;• Algoritmo de Kahn (Ordenação Topológica)&#xa;• Detecção de ciclos (DAGCycleError)&#xa;• Compilador Jobs API v2.1 &amp; Master DAG Runner" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAF5FF;strokeColor=#A855F7;align=left;spacingLeft=15;fontSize=11;" vertex="1" parent="t_local">
          <mxGeometry x="30" y="215" width="400" height="85" as="geometry" />
        </mxCell>

        <mxCell id="t_docker" value="Container Docker Lakehouse&#xa;• Debian Bullseye + OpenJDK 11&#xa;• PySpark 3.5.0 + Delta-Spark 3.0.0&#xa;• Volume: local_data_lake (Persistência Delta local)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#F59E0B;align=left;spacingLeft=15;fontSize=11;" vertex="1" parent="t_local">
          <mxGeometry x="30" y="320" width="400" height="85" as="geometry" />
        </mxCell>

        <mxCell id="t_tests" value="Suíte de Testes (Chispa + Pytest)&#xa;• assert_df_equality: comparação exata de esquemas e dados&#xa;• pytest-benchmark: medição de throughput&#xa;• Testes de integração de catálogo e partição" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;align=left;spacingLeft=15;fontSize=11;" vertex="1" parent="t_local">
          <mxGeometry x="30" y="425" width="400" height="85" as="geometry" />
        </mxCell>

        <mxCell id="t_connect" value="Databricks Connect v2 (gRPC)&#xa;• EXECUTION_MODE=remote&#xa;• Sessão remota contra cluster Databricks ativo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#8B5CF6;align=left;spacingLeft=15;fontSize=11;" vertex="1" parent="t_local">
          <mxGeometry x="30" y="530" width="400" height="65" as="geometry" />
