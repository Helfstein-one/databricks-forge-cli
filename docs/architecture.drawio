        <!-- ZONE 2: GITHUB ACTIONS & MULTI-JOB DAG -->
        <mxCell id="zone_cicd" value="2. Multi-Job DAG &amp; GitHub Actions CI/CD" style="swimlane;whiteSpace=wrap;html=1;fontSize=14;fontStyle=1;fillColor=#F8FAFC;strokeColor=#10B981;startSize=30;rounded=1;" vertex="1" parent="1">
