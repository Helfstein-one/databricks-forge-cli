        <mxCell id="sub_secrets" value="Secrets &amp; Environment Variable Engine&#xa;• Local .env parsing (databricks_forge.core.secrets)&#xa;• forge secret sync-env → Databricks Secret Scope&#xa;• Hybrid get_secret() abstraction (dbutils vs os.getenv)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;align=left;spacingLeft=15;fontSize=11;" vertex="1" parent="zone_local">
          <mxGeometry x="40" y="120" width="400" height="85" as="geometry" />
        </mxCell>

        <mxCell id="sub_compute" value="Compute &amp; Machine Catalog (core/compute.py)&#xa;• AWS: i3.xlarge (NVMe), m5d.large, c5.xlarge&#xa;• Azure: Standard_DS3_v2, Standard_D4s_v5&#xa;• GCP: n1-standard-4 · CE: SingleNode (Free Tier, 0 workers)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#F59E0B;align=left;spacingLeft=15;fontSize=11;" vertex="1" parent="zone_local">
          <mxGeometry x="40" y="225" width="400" height="85" as="geometry" />
        </mxCell>
        
        <mxCell id="sub_code" value="Scaffolded Lakehouse Project&#xa;• src/{{project_slug}}/: session.py, catalog.py, secrets.py&#xa;• sql/: 01_clean_transactions.sql, 02_gold_metrics.sql&#xa;• workflow.yaml: Multi-Job DAG orchestration definition&#xa;• notebooks/: master_dag_runner.py, run_pipeline_notebook.py" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#93C5FD;align=left;spacingLeft=15;fontSize=11;" vertex="1" parent="zone_local">
