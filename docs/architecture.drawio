        <mxCell id="sub_connect" value="Databricks Connect v2 Mode&#xa;• EXECUTION_MODE=remote&#xa;• Direct remote DataFrame execution" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#8B5CF6;align=left;spacingLeft=15;fontSize=11;" vertex="1" parent="zone_local">
