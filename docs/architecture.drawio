        <mxCell id="dag_node" value="Multi-Job Directed Acyclic Graph (DAG)&#xa;Task 1: ingest_bronze_wheel (Python Wheel)&#xa;    ↓ depends_on&#xa;Task 2: clean_silver_sql (SQL Transformation)&#xa;    ↓ depends_on&#xa;Task 3: aggregate_gold_sql (SQL KPIs Analytics)&#xa;    ↓ depends_on&#xa;Task 4: analytics_notebook (Interactive Reporting)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;align=left;spacingLeft=15;fontSize=11;fontStyle=1;" vertex="1" parent="zone_cicd">
          <mxGeometry x="40" y="50" width="400" height="150" as="geometry" />
        </mxCell>

        <mxCell id="ci_job" value="CI Pipeline (.github/workflows/ci.yml)&#xa;• Linting (Ruff check &amp; format)&#xa;• OpenJDK 11 Setup + Matrix (3.10, 3.11, 3.12)&#xa;• Chispa Unit Tests + Performance Benchmarks&#xa;• Wheel Build &amp; Artifact Storage" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;align=left;spacingLeft=15;fontSize=12;" vertex="1" parent="zone_cicd">
          <mxGeometry x="40" y="230" width="400" height="130" as="geometry" />
        </mxCell>
        
        <mxCell id="git_merge" value="Main Branch Merge / Release Trigger" style="rhombus;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#6B7280;fontStyle=1;fontSize=11;" vertex="1" parent="zone_cicd">
          <mxGeometry x="135" y="400" width="210" height="70" as="geometry" />
        </mxCell>
        
        <mxCell id="cd_job" value="CD Pipeline (.github/workflows/cd.yml)&#xa;• Databricks Secrets: DATABRICKS_HOST, TOKEN&#xa;• Automated forge deploy:&#xa;  - Workspace Import API v2.0&#xa;  - Upload Wheel (.whl)&#xa;  - Upload SQL scripts (sql/*.sql)&#xa;  - Upload Master DAG Runner &amp; Notebooks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;align=left;spacingLeft=15;fontSize=12;" vertex="1" parent="zone_cicd">
