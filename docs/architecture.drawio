        <mxCell id="t_wheel" value="Pacote Wheel (.whl)&#xa;dist/{{project_slug}}-0.2.0-py3-none-any.whl" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#FFFBEB;strokeColor=#D97706;size=14;fontStyle=1;" vertex="1" parent="t_local">
          <mxGeometry x="110" y="620" width="240" height="60" as="geometry" />
        </mxCell>

        <!-- ZONE 2: CI/CD & ORCHESTRATION -->
        <mxCell id="t_cicd" value="GitHub Actions CI/CD &amp; Automação" style="swimlane;whiteSpace=wrap;html=1;fontSize=14;fontStyle=1;fillColor=#F8FAFC;strokeColor=#10B981;startSize=30;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="580" y="120" width="480" height="780" as="geometry" />
        </mxCell>

        <mxCell id="t_ci_pipeline" value="CI Pipeline (.github/workflows/ci.yml)&#xa;1. Ruff: Linting e formatação estrita de código&#xa;2. OpenJDK 11 + Python Matrix (3.10, 3.11, 3.12)&#xa;3. Execução Chispa Unit Tests &amp; Benchmarks&#xa;4. Build e empacotamento do Wheel (.whl)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;align=left;spacingLeft=15;fontSize=11;" vertex="1" parent="t_cicd">
          <mxGeometry x="40" y="50" width="400" height="110" as="geometry" />
        </mxCell>

        <mxCell id="t_dag_spec" value="DAG Workflow Spec (workflow.yaml)&#xa;• Tarefa 1: ingest_bronze (Wheel Python)&#xa;    ↓ depends_on&#xa;• Tarefa 2: clean_silver_sql (SQL Script)&#xa;    ↓ depends_on&#xa;• Tarefa 3: aggregate_gold_sql (SQL KPIs)&#xa;    ↓ depends_on&#xa;• Tarefa 4: analytics_notebook (Interactive Reporting)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAF5FF;strokeColor=#8B5CF6;align=left;spacingLeft=15;fontSize=11;fontStyle=1;" vertex="1" parent="t_cicd">
          <mxGeometry x="40" y="180" width="400" height="150" as="geometry" />
        </mxCell>

        <mxCell id="t_cd_pipeline" value="CD Pipeline (.github/workflows/cd.yml)&#xa;• Injeção de Secrets do GitHub:&#xa;  - DATABRICKS_HOST&#xa;  - DATABRICKS_TOKEN&#xa;• Execução automatizada de forge deploy:&#xa;  - Upload do binário Wheel&#xa;  - Upload de scripts SQL (sql/*.sql)&#xa;  - Sincronização do Master DAG Runner" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;align=left;spacingLeft=15;fontSize=11;" vertex="1" parent="t_cicd">
          <mxGeometry x="40" y="350" width="400" height="160" as="geometry" />
        </mxCell>

        <!-- ZONE 3: DATABRICKS CLOUD ARCHITECTURE -->
        <mxCell id="t_cloud" value="Databricks Cloud Architecture (Control &amp; Compute Planes)" style="swimlane;whiteSpace=wrap;html=1;fontSize=14;fontStyle=1;fillColor=#F8FAFC;strokeColor=#FF3621;startSize=30;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="1120" y="120" width="540" height="780" as="geometry" />
        </mxCell>

        <mxCell id="t_control_plane" value="Databricks Control Plane (REST APIs)&#xa;• Workspace Import API (/api/2.0/workspace/import) [Base64]&#xa;• Secrets REST API (/api/2.0/secrets/*) [Secret Scopes]&#xa;• Jobs API v2.1 (/api/2.1/jobs/create &amp; submit)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontStyle=1;fontSize=11;align=left;spacingLeft=15;" vertex="1" parent="t_cloud">
          <mxGeometry x="40" y="50" width="460" height="80" as="geometry" />
        </mxCell>

        <mxCell id="t_workspace_dir" value="Databricks Workspace (/Shared/forge_deployments/...)&#xa;├── {{project_slug}}-0.2.0-py3-none-any.whl&#xa;├── master_dag_runner (Orquestrador do DAG no CE)&#xa;├── run_pipeline_notebook (Notebook com Widgets)&#xa;└── sql/ (01_clean_transactions.sql, 02_gold_metrics.sql)" style="shape=folder;fontStyle=1;spacingTop=10;tabWidth=220;tabHeight=30;tabPosition=left;html=1;whiteSpace=wrap;fillColor=#FEF3C7;strokeColor=#D97706;align=left;spacingLeft=20;fontSize=11;" vertex="1" parent="t_cloud">
          <mxGeometry x="40" y="150" width="460" height="120" as="geometry" />
        </mxCell>

        <mxCell id="t_compute_plane" value="Databricks Compute Plane (Clusters Homologados)&#xa;• AWS: i3.xlarge (Local NVMe SSD), m5d.large&#xa;• Azure: Standard_DS3_v2, Standard_D4s_v5&#xa;• GCP: n1-standard-4&#xa;• Community Edition (CE): SingleNode (Free Tier, 0 workers)&#xa;• Runtime: DBR 14.3 LTS (Apache Spark 3.5.x, Delta Lake 3.x)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E293B;fontColor=#FFFFFF;fontStyle=1;fontSize=11;align=left;spacingLeft=15;" vertex="1" parent="t_cloud">
          <mxGeometry x="40" y="290" width="460" height="110" as="geometry" />
        </mxCell>

        <mxCell id="t_storage_plane" value="Camada de Dados ACID (Delta Lake &amp; Metastore)&#xa;• default.{{project_slug}}_bronze (Ingestão Bruta)&#xa;• default.{{project_slug}}_silver_sql (Dados Higienizados)&#xa;• default.{{project_slug}}_gold_sql (KPIs Analíticos Agregados)&#xa;• Armazenamento em Parquet + Delta Transaction Log" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#DBEAFE;strokeColor=#3B82F6;fontStyle=1;align=left;spacingLeft=15;fontSize=11;" vertex="1" parent="t_cloud">
          <mxGeometry x="80" y="420" width="380" height="100" as="geometry" />
