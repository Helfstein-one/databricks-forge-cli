        <!-- ZONE 1: LOCAL RUNTIME -->
        <mxCell id="t_local" value="Ambiente Local &amp; Docker Runtime" style="swimlane;whiteSpace=wrap;html=1;fontSize=14;fontStyle=1;fillColor=#F8FAFC;strokeColor=#1E40AF;startSize=30;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="120" width="460" height="780" as="geometry" />
