        <mxCell id="sub_tests" value="Robust Test Suites&#xa;• tests/unit: Chispa (assert_df_equality)&#xa;• tests/integration: CatalogManager Disk I/O&#xa;• tests/performance: pytest-benchmark" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;align=left;spacingLeft=15;fontSize=11;" vertex="1" parent="zone_local">
