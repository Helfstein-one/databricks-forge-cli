# Environment execution mode: 'local' (Docker/Local Delta) or 'remote' (Databricks Connect)
EXECUTION_MODE=local

# Local Delta Storage path (used when EXECUTION_MODE=local)
LOCAL_STORAGE_PATH=./data_lake

# Databricks Remote Credentials (used when EXECUTION_MODE=remote or for forge deploy)
DATABRICKS_HOST=https://community.cloud.databricks.com
DATABRICKS_TOKEN=dapi_your_personal_access_token_here
DATABRICKS_CLUSTER_ID=0000-000000-sample

# Spark Configuration
SPARK_DRIVER_MEMORY=4g
